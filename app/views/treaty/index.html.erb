<div class="reading-width">
	<%= content_tag( 'p', "A treaty is a written agreement made between two or more states that is governed by international law." ) %>
	<%= content_tag( 'p', "In the UK it is the government that negotiates and signs treaties. Once signed, the document must be scrutinised by Parliament to confirm that the UK agrees to be bound by it. Only then may the treaty be ratified (by the government formally notifying the other parties that the UK will be bound by it from a specified date)." ) %>
	
	<div id="more-information">
		<%= content_tag( 'h2', 'Find treaties' ) %>
		<div class="card-list">
			<%= render :partial => 'procedure', :collection => @procedures %>
		</div>
	</div>
	
	<div id="more-information">
		<%= content_tag( 'h2', 'More information' ) %>
		<div class="card-list">
			<a href="#" class="card">
				<div class="card-inner">
					<div class="content">
						<div class="primary-info">How Parliament treats treaties</div>
						<div class="text text-secondary">
							How Parliament scrutinises international treaties, and its powers to delay ratification of treaties.
						</div>
					</div>
				</div>
			</a>
			<a href="https://treaties.parliament.uk/Help/About" class="card">
				<div class="card-inner">
					<div class="content">
						<div class="primary-info">What is a treaty?</div>
						<div class="text text-secondary">
							A written agreement made between two or more states that is governed by international law.
						</div>
					</div>
				</div>
			</a>
		</div>
	</div>
</div>